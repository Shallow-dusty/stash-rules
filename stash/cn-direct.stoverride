name: 本地与国内直连 · 海外默认
desc: 本地网络、国内域名和国内 IP 直连；Bybit 与币安走台湾家宽自动回退组、Kraken 走海妖UK池（需配合 secret gist 覆写 own-nodes 提供组与节点）；Tailscale 地址留给独立覆写；其余流量继续使用现有 Mihomo 配置
author: Shallow-dusty
homepage: https://github.com/Shallow-dusty/stash-rules
category: Routing

proxy-groups:
  - name: Bybit-TW
    type: fallback
    proxies:
      - "🇨🇳 台湾 07 家宽"
      - "🇨🇳 台湾 08 家宽"
      - "🇨🇳 台湾 09 家宽"
    url: "https://www.gstatic.com/generate_204"
    interval: 300

rule-providers:
  personal-cn-domain:
    behavior: domain
    format: yaml
    url: https://raw.githubusercontent.com/Shallow-dusty/stash-rules/main/rules/cn-direct-domain.yaml
    interval: 3600
    path: ./rules/personal-cn-domain.yaml

rules:
  # Localhost and private networks
  - DOMAIN,localhost,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,224.0.0.0/4,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve
  # Keep ordinary ULA traffic direct, but leave Tailscale's ULA prefix unmatched.
  - AND,((IP-CIDR6,fc00::/7,no-resolve),(NOT,((IP-CIDR6,fd7a:115c:a1e0::/48,no-resolve)))),DIRECT
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  - IP-CIDR6,ff00::/8,DIRECT,no-resolve

  # Personal mainland China domain set, followed by the built-in CN IP database
  - RULE-SET,personal-cn-domain,DIRECT
  - GEOIP,CN,DIRECT

  # Bybit official domains: main/API/WS + backup domains (cert-verified), SUFFIX covers all subdomains
  - DOMAIN-SUFFIX,bybit.com,Bybit-TW
  - DOMAIN-SUFFIX,bybit.net,Bybit-TW
  - DOMAIN-SUFFIX,bybit.nl,Bybit-TW
  - DOMAIN-SUFFIX,bybitglobal.com,Bybit-TW
  # Binance official domains: main/API (same Taiwan residential trio as Bybit, per user spec 2026-08-16)
  - DOMAIN-SUFFIX,binance.com,Bybit-TW
  - DOMAIN-SUFFIX,binancezh.com,Bybit-TW
  # Kraken official domains → 海妖UK 组（自建UK主力 → MESL英国04兜底，组定义在 secret gist 覆写 own-nodes）
  # 2026-08-19: 原直指英国04家宽，但 MESL drive-cl 欧洲入口不稳致断连；改为 fallback 池且主力换自建
  - DOMAIN-SUFFIX,kraken.com,海妖UK
  - DOMAIN-SUFFIX,krakenfx.com,海妖UK
  # Krak app (krak.app): official global money app domain, covers all subdomains
  - DOMAIN-SUFFIX,krak.app,海妖UK

  # No MATCH rule here: unmatched traffic continues through the Mihomo config.
